---
layout: default
---
{% unless site.data.resume %}
  <div class="post">
    {% unless page.intro_in_first_section %}
      {% include cv/header.liquid %}
    {% endunless %}

    <article>
      <div class="cv{% if page.show_cards == false %} cv-flat{% endif %}{% if page.section_backgrounds %} cv-banded{% endif %}">
        {% for entry in site.data.cv %}
          <a class="anchor" id="{{ entry.title }}"></a>
          <div class="{% if page.show_cards == false %}cv-section{% else %}card mt-3 p-3{% endif %}{% if page.intro_in_first_section and forloop.first %} cv-intro{% endif %}">
            {% if page.intro_in_first_section and forloop.first %}
              <h1 class="card-title font-weight-normal">{{ entry.title }}</h1>
            {% else %}
              <h3 class="card-title font-weight-normal">{{ entry.title }}</h3>
            {% endif %}
            <div class="cv-section-content">
              {% if entry.type == 'list' %}
                {% include cv/list.liquid %}
              {% elsif entry.type == 'map' %}
                {% include cv/map.liquid %}
              {% elsif entry.type == 'nested_list' %}
                {% include cv/nested_list.liquid %}
              {% elsif entry.type == 'time_table' %}
                {% include cv/time_table.liquid %}
              {% elsif entry.type == 'list_groups' %}
                {% include cv/list_groups.liquid %}
              {% else %}
                {{ entry.contents }}
              {% endif %}
              {% if page.intro_in_first_section and forloop.first %}
                {% include cv/download.liquid %}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  <div class="post">
    {% unless page.intro_in_first_section %}
      {% include cv/header.liquid %}
    {% endunless %}

    <article>
      <div class="cv{% if page.show_cards == false %} cv-flat{% endif %}{% if page.section_backgrounds %} cv-banded{% endif %}">
        {% for data in site.data.resume %}
          {% if site.jsonresume and site.jsonresume.size > 0 %}
            {% unless site.jsonresume contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
          <a class="anchor" id="{{ data[0] }}"></a>
          <div class="{% if page.show_cards == false %}cv-section{% else %}card mt-3 p-3{% endif %}{% if page.intro_in_first_section and data[0] == 'basics' %} cv-intro{% endif %}">
            {% if page.intro_in_first_section and data[0] == 'basics' %}
              <h1 class="card-title font-weight-normal">Resume</h1>
            {% else %}
              <h3 class="card-title font-weight-normal">{{ data[0] | capitalize }}</h3>
            {% endif %}
            <div class="cv-section-content">
              {% case data[0] %}
                {% when 'basics' %}
                  {% include resume/basics.liquid %}
                  {% if page.intro_in_first_section %}
                    {% include cv/download.liquid %}
                  {% endif %}
                {% when 'education' %}
                  {% include resume/education.liquid %}
                {% when 'work' %}
                  {% include resume/work.liquid %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid %}
                {% when 'projects' %}
                  {% include resume/projects.liquid %}
                {% when 'awards' %}
                  {% include resume/awards.liquid %}
                {% when 'skills' %}
                  {% include resume/skills.liquid %}
                {% when 'publications' %}
                  {% include resume/publications.liquid %}
                {% when 'languages' %}
                  {% include resume/languages.liquid %}
                {% when 'interests' %}
                  {% include resume/interests.liquid %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid %}
                {% when 'references' %}
                  {% include resume/references.liquid %}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}
